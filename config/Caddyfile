{
	admin off
	log {
		level WARN
		format filter {
			request>uri delete
		}
	}
	persist_config off
	auto_https off
}

http://:{$EDGE_PORT} {
	route {
		@health path /healthz
		respond @health "ok" 200

		@wrongHost not host {$EDGE_HOST}
		respond @wrongHost 421

		@crossSite {
			header Sec-Fetch-Site cross-site
			not {
				method GET
				path / /_diagnostics
				header Sec-Fetch-Mode navigate
				header_regexp Sec-Fetch-Dest ^document$
			}
		}
		respond @crossSite 403

		header {
			-Server
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
		}

		@disabled expression `"{$EDGE_LOCKED}" == "yes"`
		respond @disabled "Configuration requise dans les variables d’environnement du serveur." 503

		basic_auth {
			{$EDGE_USER} {$EDGE_PASSWORD_HASH}
		}

		@status path /_status
		respond @status "{$EDGE_STATUS}" 200

		@diagnostics path /_diagnostics /_diagnostics/*
		reverse_proxy @diagnostics 127.0.0.1:{$DSH_LOGIN_PORT} {
			header_up -Authorization
			header_up -Cookie
		}

		@newSession {
			method GET
			path /_login /
			expression {http.request.uri.path} == "/_login" || !{http.request.header.Cookie}.contains("dsh-auth-")
		}
		reverse_proxy @newSession 127.0.0.1:{$DSH_LOGIN_PORT} {
			header_up -Authorization
			header_up -Cookie
			{$EDGE_COOKIE_DIRECTIVE}
		}

		reverse_proxy 127.0.0.1:{$DSH_PORT} {
			header_up -Authorization
			header_up -Proxy-Authorization
			{$EDGE_COOKIE_DIRECTIVE}
			flush_interval -1

			@expiredSession status 401
			handle_response @expiredSession {
				@home {
					method GET
					path /
				}
				redir @home /_login 303
				copy_response
			}
		}
	}
}
